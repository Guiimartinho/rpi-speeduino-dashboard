[Unit]
Description=Speeduino HMI Launcher (Dashboard UI)
Documentation=https://github.com/speeduino/speeduino-ui
# Dependencies: Wait for display and data services before starting
# can_service provides engine data - required for dashboard to function
# reverse_service provides reverse camera trigger - optional but useful
After=graphical.target can_service.service reverse_service.service
Requires=graphical.target can_service.service
Wants=reverse_service.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=pi
Group=pi

# Environment for Qt/Wayland/EGLFS
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_KMS_ATOMIC=1
Environment=QT_LOGGING_RULES=qt.qpa.*=false
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=QML_DISK_CACHE_PATH=/tmp/qml_cache

# Performance optimizations for Qt
# Use basic render loop to reduce CPU usage (especially important for software renderer)
Environment=QSG_RENDER_LOOP=basic
# Limit llvmpipe threads to 1 (software renderer fallback on RPi4 X11)
Environment=LP_NUM_THREADS=1
# Note: QT_QUICK_BACKEND removed - let Qt choose best backend (hardware if available)

ExecStart=/usr/local/bin/hmi_launcher --fullscreen --config=/etc/speeduino-ui
Restart=always
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=10

# Watchdog support
WatchdogSec=15

# Allow access to display, input, USB devices
SupplementaryGroups=video input render audio plugdev bluetooth

# Security hardening - filesystem (relaxed for GUI)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadOnlyPaths=/
ReadWritePaths=/tmp /run /var/tmp

# Security hardening - network (needs Bluetooth for Android Auto)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_BLUETOOTH
PrivateNetwork=false

# Security hardening - capabilities
CapabilityBoundingSet=CAP_SYS_NICE
AmbientCapabilities=CAP_SYS_NICE

# Security hardening - syscall filtering (relaxed for graphics)
SystemCallFilter=@system-service @network-io @ipc
SystemCallArchitectures=native

# Security hardening - misc
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
UMask=0022

# Device access for display, input, USB (for Android Auto)
DevicePolicy=auto
DeviceAllow=/dev/dri/* rw
DeviceAllow=/dev/input/* rw
DeviceAllow=/dev/tty* rw
DeviceAllow=/dev/fb* rw
DeviceAllow=/dev/video* rw
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/snd/* rw
DeviceAllow=/dev/bus/usb/* rw
DeviceAllow=/dev/ttyUSB* rw
DeviceAllow=/dev/ttyACM* rw

# IPC paths for ZeroMQ
ReadWritePaths=/tmp/speeduino_data.ipc
ReadWritePaths=/tmp/speeduino_cmd.ipc
ReadWritePaths=/tmp/reverse_trigger.ipc
ReadWritePaths=/tmp/steering_events.ipc
ReadWritePaths=/tmp/qml_cache

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hmi_launcher

# Resource limits (higher for UI)
MemoryMax=512M
MemoryHigh=384M
CPUQuota=80%
TasksMax=64
LimitNOFILE=4096
IOWeight=100

# Scheduling (lower priority than CAN service)
Nice=0
CPUAffinity=0 1

[Install]
WantedBy=graphical.target
