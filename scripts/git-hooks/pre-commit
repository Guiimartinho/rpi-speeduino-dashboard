#!/usr/bin/env python
"""
Pre-commit hook for speeduino-ui-openauto
Runs code quality checks before allowing commits

Standalone - no external dependencies (Python stdlib only)
Works on Windows and Linux
"""

import os
import sys
import subprocess
import re
from pathlib import Path

# =============================================================================
# COLORS (cross-platform)
# =============================================================================
COLORS_ENABLED = False

if sys.platform == "win32":
    # Enable ANSI on Windows 10+
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        kernel32.SetConsoleMode(kernel32.GetStdHandle(-11), 7)
        COLORS_ENABLED = True
    except Exception:
        COLORS_ENABLED = False
else:
    COLORS_ENABLED = sys.stdout.isatty()


def color(text: str, code: str) -> str:
    if not COLORS_ENABLED:
        return text
    colors = {
        "red": "\033[0;31m",
        "green": "\033[0;32m",
        "yellow": "\033[1;33m",
        "blue": "\033[0;34m",
        "reset": "\033[0m",
    }
    return f"{colors.get(code, '')}{text}{colors['reset']}"


def print_ok(msg: str):
    print(color(f"  [OK] {msg}", "green"))


def print_fail(msg: str):
    print(color(f"  [FAIL] {msg}", "red"))


def print_warn(msg: str):
    print(color(f"  [WARN] {msg}", "yellow"))


def print_skip(msg: str):
    print(color(f"  [SKIP] {msg}", "yellow"))


def print_header(msg: str):
    print(color(f"\n{msg}", "yellow"))


# =============================================================================
# UTILITIES
# =============================================================================
def run_command(cmd: list, capture: bool = True) -> tuple:
    """Run a command and return (success, output)"""
    try:
        result = subprocess.run(
            cmd,
            capture_output=capture,
            text=True,
            timeout=60
        )
        return result.returncode == 0, result.stdout + result.stderr
    except FileNotFoundError:
        return None, "Command not found"
    except subprocess.TimeoutExpired:
        return False, "Command timed out"
    except Exception as e:
        return False, str(e)


def command_exists(cmd: str) -> bool:
    """Check if a command exists in PATH"""
    try:
        if sys.platform == "win32":
            result = subprocess.run(
                ["where", cmd],
                capture_output=True,
                creationflags=subprocess.CREATE_NO_WINDOW if hasattr(subprocess, 'CREATE_NO_WINDOW') else 0
            )
        else:
            result = subprocess.run(["which", cmd], capture_output=True)
        return result.returncode == 0
    except Exception:
        return False


def find_clang_format() -> str:
    """Find clang-format or clang-format-17 executable"""
    for cmd in ["clang-format-17", "clang-format"]:
        if command_exists(cmd):
            return cmd
    return ""


def get_staged_files() -> list:
    """Get list of staged files"""
    success, output = run_command(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"])
    if success:
        return [f.strip() for f in output.strip().split("\n") if f.strip()]
    return []


# =============================================================================
# AUTO-FIX: CRLF to LF
# =============================================================================
def fix_line_endings(files: list) -> int:
    """Auto-fix CRLF to LF line endings"""
    text_extensions = (
        '.cpp', '.hpp', '.h', '.c',
        '.qml', '.js', '.py', '.sh',
        '.yaml', '.yml', '.json', '.xml',
        '.cmake', '.md', '.txt'
    )

    fixed_count = 0
    for file in files:
        if not os.path.exists(file):
            continue

        # Check if it's a text file
        if not any(file.lower().endswith(ext) for ext in text_extensions):
            if Path(file).name not in ('CMakeLists.txt', 'Makefile', '.gitignore'):
                continue

        try:
            with open(file, 'rb') as f:
                content = f.read()

            # Check for CRLF
            if b'\r\n' in content:
                # Convert CRLF to LF
                new_content = content.replace(b'\r\n', b'\n')
                with open(file, 'wb') as f:
                    f.write(new_content)

                # Re-stage the file
                run_command(["git", "add", file])
                fixed_count += 1
        except Exception:
            pass

    return fixed_count


# =============================================================================
# CHECKS
# =============================================================================
def check_cpp_formatting(files: list) -> int:
    """Check C++ files with clang-format"""
    cpp_files = [f for f in files if Path(f).suffix.lower() in ('.cpp', '.hpp', '.h', '.c')]

    if not cpp_files:
        return 0

    clang_format = find_clang_format()
    if not clang_format:
        print_skip("clang-format not installed (optional)")
        print_warn("To enable C++ formatting checks, install clang-format:")
        print("         Cross-platform: pip install clang-format")
        print("         Ubuntu/Debian:  sudo apt install clang-format-17")
        print("         macOS:          brew install clang-format")
        print("         Windows:        choco install llvm  OR  pip install clang-format")
        return 0

    print_header("Checking C++ formatting...")
    errors = 0

    for file in cpp_files:
        if not os.path.exists(file):
            continue
        success, output = run_command([clang_format, "--dry-run", "--Werror", file])
        if success is None:
            print_skip(f"{clang_format} not available for {file}")
        elif success:
            print_ok(file)
        else:
            print_fail(f"{file} needs formatting")
            print(f"         Run: {clang_format} -i {file}")
            errors += 1

    return errors


def check_qml_files(files: list) -> int:
    """Basic QML validation"""
    qml_files = [f for f in files if Path(f).suffix.lower() == '.qml']

    if not qml_files:
        return 0

    print_header("Checking QML files...")
    errors = 0

    for file in qml_files:
        if not os.path.exists(file):
            continue
        try:
            with open(file, 'r', encoding='utf-8') as f:
                content = f.read()

            open_braces = content.count('{')
            close_braces = content.count('}')

            if open_braces != close_braces:
                print_fail(f"{file} has unbalanced braces (open: {open_braces}, close: {close_braces})")
                errors += 1
            else:
                print_ok(file)
        except Exception as e:
            print_fail(f"{file}: {e}")
            errors += 1

    return errors


def check_yaml_files(files: list) -> int:
    """Basic YAML validation"""
    yaml_files = [f for f in files if Path(f).suffix.lower() in ('.yaml', '.yml')]

    if not yaml_files:
        return 0

    print_header("Checking YAML files...")
    errors = 0

    for file in yaml_files:
        if not os.path.exists(file):
            continue
        try:
            with open(file, 'r', encoding='utf-8') as f:
                content = f.read()

            # Basic YAML validation (tabs are not allowed in YAML)
            lines = content.split('\n')
            for i, line in enumerate(lines, 1):
                if '\t' in line and not line.strip().startswith('#'):
                    print_fail(f"{file}:{i} contains tabs (YAML requires spaces)")
                    errors += 1
                    break
            else:
                print_ok(file)
        except Exception as e:
            print_fail(f"{file}: {e}")
            errors += 1

    return errors


def check_shell_scripts(files: list) -> int:
    """Check shell scripts with shellcheck"""
    sh_files = [f for f in files if Path(f).suffix.lower() == '.sh']

    if not sh_files:
        return 0

    if not command_exists("shellcheck"):
        print_skip("shellcheck not installed")
        return 0

    print_header("Checking shell scripts...")
    errors = 0

    for file in sh_files:
        if not os.path.exists(file):
            continue
        success, output = run_command(["shellcheck", "-S", "warning", file])
        if success is None:
            print_skip(f"shellcheck not available for {file}")
        elif success:
            print_ok(file)
        else:
            print_fail(f"{file} has shellcheck warnings")
            errors += 1

    return errors


def check_sensitive_files(files: list) -> int:
    """Check for potentially sensitive files"""
    print_header("Checking for sensitive files...")

    sensitive_patterns = [
        r'\.env$',
        r'\.env\.',
        r'credentials',
        r'secrets',
        r'\.pem$',
        r'\.key$',
        r'id_rsa',
        r'id_ed25519',
        r'\.p12$',
        r'\.pfx$',
        r'password',
    ]

    errors = 0
    for file in files:
        for pattern in sensitive_patterns:
            if re.search(pattern, file, re.IGNORECASE):
                print_fail(f"Potentially sensitive file: {file}")
                errors += 1
                break

    if errors == 0:
        print_ok("No sensitive files detected")

    return errors


def check_large_files(files: list) -> int:
    """Check for files larger than 1MB"""
    print_header("Checking for large files...")

    errors = 0
    max_size = 1024 * 1024  # 1MB

    for file in files:
        if not os.path.exists(file):
            continue
        try:
            size = os.path.getsize(file)
            if size > max_size:
                size_mb = size / (1024 * 1024)
                print_fail(f"{file} is too large ({size_mb:.2f}MB > 1MB)")
                print("         Consider using Git LFS for large files")
                errors += 1
        except Exception:
            pass

    if errors == 0:
        print_ok("No oversized files")

    return errors


def check_cmake_files(files: list) -> int:
    """Basic CMakeLists.txt validation"""
    cmake_files = [f for f in files if Path(f).name == 'CMakeLists.txt']

    if not cmake_files:
        return 0

    print_header("Checking CMake files...")

    for file in cmake_files:
        if not os.path.exists(file):
            continue
        try:
            with open(file, 'r', encoding='utf-8') as f:
                content = f.read()

            has_cmake_req = 'cmake_minimum_required' in content
            has_target = any(x in content for x in ['add_executable', 'add_library', 'qt_add'])

            if has_cmake_req or has_target:
                print_ok(file)
            else:
                print_warn(f"{file} may be incomplete")
        except Exception as e:
            print_fail(f"{file}: {e}")

    return 0


# =============================================================================
# MAIN
# =============================================================================
def main() -> int:
    print(color("Running pre-commit checks...", "yellow"))

    staged_files = get_staged_files()

    if not staged_files:
        print_ok("No files staged, skipping checks.")
        return 0

    # Auto-fix line endings (CRLF -> LF)
    fixed = fix_line_endings(staged_files)
    if fixed > 0:
        print(color(f"  [AUTO-FIX] Converted {fixed} file(s) from CRLF to LF", "blue"))
        # Refresh staged files list after fixes
        staged_files = get_staged_files()

    total_errors = 0

    # Run all checks
    total_errors += check_cpp_formatting(staged_files)
    total_errors += check_qml_files(staged_files)
    total_errors += check_yaml_files(staged_files)
    total_errors += check_shell_scripts(staged_files)
    total_errors += check_sensitive_files(staged_files)
    total_errors += check_large_files(staged_files)
    total_errors += check_cmake_files(staged_files)

    # Final result
    print()
    if total_errors > 0:
        print(color("========================================", "red"))
        print(color(f"Pre-commit checks FAILED ({total_errors} errors)", "red"))
        print(color("========================================", "red"))
        print(color("Fix the issues above or use 'git commit --no-verify' to skip", "yellow"))
        return 1
    else:
        print(color("========================================", "green"))
        print(color("All pre-commit checks passed!", "green"))
        print(color("========================================", "green"))
        return 0


if __name__ == "__main__":
    sys.exit(main())
