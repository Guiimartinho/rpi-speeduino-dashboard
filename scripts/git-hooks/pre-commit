#!/bin/bash
#
# Pre-commit hook for speeduino-ui-openauto
# Runs code quality checks before allowing commits
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No files staged, skipping checks.${NC}"
    exit 0
fi

ERRORS=0

# =============================================================================
# CHECK 1: C++ files formatting (clang-format)
# =============================================================================
CPP_FILES=$(echo "$STAGED_FILES" | grep -E '\.(cpp|hpp|h|c)$' || true)

if [ -n "$CPP_FILES" ] && command -v clang-format &> /dev/null; then
    echo -e "\n${YELLOW}Checking C++ formatting...${NC}"

    for file in $CPP_FILES; do
        if [ -f "$file" ]; then
            # Check if file would be modified by clang-format
            if ! clang-format --dry-run --Werror "$file" 2>/dev/null; then
                echo -e "${RED}  [FAIL] $file needs formatting${NC}"
                echo -e "         Run: clang-format -i $file"
                ERRORS=$((ERRORS + 1))
            else
                echo -e "${GREEN}  [OK] $file${NC}"
            fi
        fi
    done
elif [ -n "$CPP_FILES" ]; then
    echo -e "${YELLOW}  [SKIP] clang-format not installed${NC}"
fi

# =============================================================================
# CHECK 2: QML files basic validation
# =============================================================================
QML_FILES=$(echo "$STAGED_FILES" | grep -E '\.qml$' || true)

if [ -n "$QML_FILES" ]; then
    echo -e "\n${YELLOW}Checking QML files...${NC}"

    for file in $QML_FILES; do
        if [ -f "$file" ]; then
            # Basic syntax check - look for common errors
            if grep -qE '^\s*import\s+[^"\n]+$' "$file" 2>/dev/null; then
                # Check for balanced braces
                OPEN=$(grep -o '{' "$file" | wc -l)
                CLOSE=$(grep -o '}' "$file" | wc -l)

                if [ "$OPEN" -ne "$CLOSE" ]; then
                    echo -e "${RED}  [FAIL] $file has unbalanced braces (open: $OPEN, close: $CLOSE)${NC}"
                    ERRORS=$((ERRORS + 1))
                else
                    echo -e "${GREEN}  [OK] $file${NC}"
                fi
            else
                echo -e "${GREEN}  [OK] $file${NC}"
            fi
        fi
    done
fi

# =============================================================================
# CHECK 3: YAML files validation
# =============================================================================
YAML_FILES=$(echo "$STAGED_FILES" | grep -E '\.(yaml|yml)$' || true)

if [ -n "$YAML_FILES" ] && command -v python3 &> /dev/null; then
    echo -e "\n${YELLOW}Checking YAML files...${NC}"

    for file in $YAML_FILES; do
        if [ -f "$file" ]; then
            if python3 -c "import yaml; yaml.safe_load(open('$file'))" 2>/dev/null; then
                echo -e "${GREEN}  [OK] $file${NC}"
            else
                echo -e "${RED}  [FAIL] $file has invalid YAML syntax${NC}"
                ERRORS=$((ERRORS + 1))
            fi
        fi
    done
fi

# =============================================================================
# CHECK 4: Shell scripts (shellcheck)
# =============================================================================
SH_FILES=$(echo "$STAGED_FILES" | grep -E '\.sh$' || true)

if [ -n "$SH_FILES" ] && command -v shellcheck &> /dev/null; then
    echo -e "\n${YELLOW}Checking shell scripts...${NC}"

    for file in $SH_FILES; do
        if [ -f "$file" ]; then
            if shellcheck -S warning "$file" 2>/dev/null; then
                echo -e "${GREEN}  [OK] $file${NC}"
            else
                echo -e "${RED}  [FAIL] $file has shellcheck warnings${NC}"
                ERRORS=$((ERRORS + 1))
            fi
        fi
    done
elif [ -n "$SH_FILES" ]; then
    echo -e "${YELLOW}  [SKIP] shellcheck not installed${NC}"
fi

# =============================================================================
# CHECK 5: Prevent committing sensitive files
# =============================================================================
echo -e "\n${YELLOW}Checking for sensitive files...${NC}"

SENSITIVE_PATTERNS=(
    '\.env$'
    '\.env\.'
    'credentials'
    'secrets'
    '\.pem$'
    '\.key$'
    'id_rsa'
    'id_ed25519'
    '\.p12$'
    '\.pfx$'
)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    MATCHES=$(echo "$STAGED_FILES" | grep -iE "$pattern" || true)
    if [ -n "$MATCHES" ]; then
        echo -e "${RED}  [FAIL] Potentially sensitive file detected:${NC}"
        echo "$MATCHES" | while read -r f; do
            echo -e "${RED}         - $f${NC}"
        done
        ERRORS=$((ERRORS + 1))
    fi
done

if [ $ERRORS -eq 0 ]; then
    echo -e "${GREEN}  [OK] No sensitive files detected${NC}"
fi

# =============================================================================
# CHECK 6: Large files check (>1MB)
# =============================================================================
echo -e "\n${YELLOW}Checking for large files...${NC}"

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        SIZE=$(wc -c < "$file" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt 1048576 ]; then
            SIZE_MB=$(echo "scale=2; $SIZE / 1048576" | bc 2>/dev/null || echo "1+")
            echo -e "${RED}  [FAIL] $file is too large (${SIZE_MB}MB > 1MB)${NC}"
            echo -e "         Consider using Git LFS for large files"
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

if [ $ERRORS -eq 0 ]; then
    echo -e "${GREEN}  [OK] No oversized files${NC}"
fi

# =============================================================================
# CHECK 7: CMakeLists.txt validation
# =============================================================================
CMAKE_FILES=$(echo "$STAGED_FILES" | grep -E 'CMakeLists\.txt$' || true)

if [ -n "$CMAKE_FILES" ]; then
    echo -e "\n${YELLOW}Checking CMake files...${NC}"

    for file in $CMAKE_FILES; do
        if [ -f "$file" ]; then
            # Check for common CMake issues
            if grep -qE 'cmake_minimum_required' "$file" 2>/dev/null || \
               grep -qE '(add_executable|add_library|qt_add)' "$file" 2>/dev/null; then
                echo -e "${GREEN}  [OK] $file${NC}"
            else
                echo -e "${YELLOW}  [WARN] $file may be incomplete${NC}"
            fi
        fi
    done
fi

# =============================================================================
# FINAL RESULT
# =============================================================================
echo ""
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}Pre-commit checks FAILED ($ERRORS errors)${NC}"
    echo -e "${RED}========================================${NC}"
    echo -e "${YELLOW}Fix the issues above or use 'git commit --no-verify' to skip${NC}"
    exit 1
else
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}All pre-commit checks passed!${NC}"
    echo -e "${GREEN}========================================${NC}"
    exit 0
fi
