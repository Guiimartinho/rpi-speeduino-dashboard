#!/usr/bin/env python
"""
Pre-push hook for speeduino-ui-openauto
Runs validation before allowing pushes to remote

Standalone - no external dependencies (Python stdlib only)
Works on Windows and Linux
"""

import os
import sys
import subprocess
import re
from pathlib import Path

# =============================================================================
# COLORS (cross-platform)
# =============================================================================
COLORS_ENABLED = False

if sys.platform == "win32":
    # Enable ANSI on Windows 10+
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        kernel32.SetConsoleMode(kernel32.GetStdHandle(-11), 7)
        COLORS_ENABLED = True
    except Exception:
        COLORS_ENABLED = False
else:
    COLORS_ENABLED = sys.stdout.isatty()


def color(text: str, code: str) -> str:
    if not COLORS_ENABLED:
        return text
    colors = {
        "red": "\033[0;31m",
        "green": "\033[0;32m",
        "yellow": "\033[1;33m",
        "blue": "\033[0;34m",
        "reset": "\033[0m",
    }
    return f"{colors.get(code, '')}{text}{colors['reset']}"


def print_ok(msg: str):
    print(color(f"  [OK] {msg}", "green"))


def print_fail(msg: str):
    print(color(f"  [FAIL] {msg}", "red"))


def print_warn(msg: str):
    print(color(f"  [WARN] {msg}", "yellow"))


def print_skip(msg: str):
    print(color(f"  [SKIP] {msg}", "yellow"))


def print_header(msg: str):
    print(color(f"\n{msg}", "yellow"))


# =============================================================================
# UTILITIES
# =============================================================================
def run_command(cmd: list, capture: bool = True) -> tuple:
    """Run a command and return (success, output)"""
    try:
        result = subprocess.run(
            cmd,
            capture_output=capture,
            text=True,
            timeout=120
        )
        return result.returncode == 0, result.stdout + result.stderr
    except FileNotFoundError:
        return None, "Command not found"
    except subprocess.TimeoutExpired:
        return False, "Command timed out"
    except Exception as e:
        return False, str(e)


def get_current_branch() -> str:
    """Get current git branch name"""
    success, output = run_command(["git", "rev-parse", "--abbrev-ref", "HEAD"])
    if success:
        return output.strip()
    return "unknown"


def get_changed_files(branch: str) -> list:
    """Get list of files changed between remote and local"""
    # Try to get diff from origin
    success, output = run_command(["git", "diff", "--name-only", f"origin/{branch}..HEAD"])
    if success and output.strip():
        return [f.strip() for f in output.strip().split("\n") if f.strip()]

    # Fallback to last 10 commits
    success, output = run_command(["git", "diff", "--name-only", "HEAD~10..HEAD"])
    if success and output.strip():
        return [f.strip() for f in output.strip().split("\n") if f.strip()]

    return []


def get_commits(branch: str) -> list:
    """Get list of commits being pushed"""
    success, output = run_command(["git", "log", f"origin/{branch}..HEAD", "--format=%H %s"])
    if success and output.strip():
        return [line.strip() for line in output.strip().split("\n") if line.strip()]

    # Fallback
    success, output = run_command(["git", "log", "HEAD~5..HEAD", "--format=%H %s"])
    if success and output.strip():
        return [line.strip() for line in output.strip().split("\n") if line.strip()]

    return []


# =============================================================================
# CHECKS
# =============================================================================
def check_protected_branch(branch: str) -> int:
    """Warn about pushing to protected branches"""
    print_header("Checking branch protection...")

    protected_branches = ["main", "master", "production"]

    if branch in protected_branches:
        print(color("========================================", "red"))
        print(color(f"WARNING: Pushing directly to {branch}!", "red"))
        print(color("========================================", "red"))
        print(color("Consider using a feature branch and PR instead.", "yellow"))
        print()

        # In non-interactive mode (CI/CD), allow push with warning
        if not sys.stdin.isatty():
            print_warn(f"Non-interactive mode, allowing push to {branch}")
            return 0

        try:
            response = input(f"Are you sure you want to push to {branch}? [y/N] ")
            if response.lower() not in ('y', 'yes'):
                print(color("Push cancelled.", "red"))
                return 1
        except EOFError:
            # Non-interactive, allow
            pass

    print_ok("Branch check passed")
    return 0


def check_build_directory() -> int:
    """Check if build directory exists"""
    print_header("Checking build configuration...")

    if not os.path.exists("CMakeLists.txt"):
        print_skip("No CMakeLists.txt found")
        return 0

    if os.path.isdir("build") and os.path.exists("build/CMakeCache.txt"):
        print_ok("Build directory exists")
    else:
        print_skip("No build directory (run cmake to create)")

    return 0


def check_tests() -> int:
    """Check if tests pass"""
    print_header("Checking for tests...")

    if not os.path.isdir("build"):
        print_skip("No build directory")
        return 0

    if not os.path.exists("build/CTestTestfile.cmake"):
        if os.path.isdir("tests"):
            print_skip("Tests directory exists but no CTest config")
        else:
            print_skip("No tests configured")
        return 0

    print(color("  Running tests...", "yellow"))
    success, output = run_command(["ctest", "--output-on-failure", "-j4"], capture=True)

    # Run from build directory
    original_dir = os.getcwd()
    try:
        os.chdir("build")
        success, output = run_command(["ctest", "--output-on-failure", "-j4"])
    finally:
        os.chdir(original_dir)

    if success:
        print_ok("All tests passed")
        return 0
    else:
        print_fail("Tests failed")
        return 1


def check_debug_markers(files: list) -> int:
    """Check for debug code markers"""
    print_header("Checking for debug code markers...")

    if not files:
        print_skip("No changed files to check")
        return 0

    debug_patterns = [
        r'console\.log',
        r'print\s*\(',
        r'qDebug\s*\(',
        r'\bTODO\b',
        r'\bFIXME\b',
        r'\bHACK\b',
        r'\bXXX\b',
        r'\bdebugger\b',
    ]

    warnings = 0
    for file in files:
        if not os.path.exists(file):
            continue

        # Skip binary files
        if Path(file).suffix.lower() in ('.png', '.jpg', '.gif', '.ico', '.bin', '.exe'):
            continue

        try:
            with open(file, 'r', encoding='utf-8', errors='ignore') as f:
                content = f.read()

            for pattern in debug_patterns:
                matches = list(re.finditer(pattern, content, re.IGNORECASE))
                if matches:
                    if warnings == 0:
                        print(color("  Debug markers found (review before release):", "yellow"))
                    print(color(f"    {file}: {pattern} ({len(matches)} match(es))", "yellow"))
                    warnings += 1
                    break
        except Exception:
            pass

    if warnings == 0:
        print_ok("No debug markers found")
    else:
        print_warn(f"Found {warnings} files with debug markers")

    # This is a warning, not an error
    return 0


def check_commit_messages(branch: str) -> int:
    """Check commit message format"""
    print_header("Checking commit message format...")

    commits = get_commits(branch)

    if not commits:
        print_skip("No commits to check")
        return 0

    # Conventional commits pattern
    pattern = r'^[a-f0-9]+ (feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+'

    bad_commits = []
    for commit in commits:
        if not re.match(pattern, commit):
            bad_commits.append(commit)

    if bad_commits:
        print(color("  Non-conventional commit messages:", "yellow"))
        for commit in bad_commits[:5]:  # Show max 5
            print(color(f"    - {commit[:80]}", "yellow"))

    # This is a warning, not a blocker
    print_ok("Commit messages checked")
    return 0


def check_conflict_markers(files: list) -> int:
    """Check for merge conflict markers"""
    print_header("Checking for conflict markers...")

    if not files:
        print_skip("No files to check")
        return 0

    errors = 0
    conflict_pattern = r'^(<<<<<<<|=======|>>>>>>>)'

    for file in files:
        if not os.path.exists(file):
            continue

        # Skip binary files
        if Path(file).suffix.lower() in ('.png', '.jpg', '.gif', '.ico', '.bin', '.exe'):
            continue

        try:
            with open(file, 'r', encoding='utf-8', errors='ignore') as f:
                for line_num, line in enumerate(f, 1):
                    if re.match(conflict_pattern, line):
                        print_fail(f"Conflict markers in: {file}:{line_num}")
                        errors += 1
                        break
        except Exception:
            pass

    if errors == 0:
        print_ok("No conflict markers")

    return errors


def check_ignored_files() -> int:
    """Check for files that should be ignored"""
    print_header("Checking for ignored files...")

    success, output = run_command(["git", "ls-files", "-i", "--exclude-standard"])

    if success and output.strip():
        files = output.strip().split("\n")[:5]
        print_warn("These files are tracked but should be ignored:")
        for f in files:
            print(color(f"    - {f}", "yellow"))
    else:
        print_ok("No improperly tracked files")

    return 0


# =============================================================================
# MAIN
# =============================================================================
def main() -> int:
    # Read push info from stdin (git provides this)
    try:
        for line in sys.stdin:
            parts = line.strip().split()
            if len(parts) >= 4:
                local_ref, local_sha, remote_ref, remote_sha = parts[:4]
                print(color(f"Push: {local_ref} -> {remote_ref}", "blue"))
    except Exception:
        pass

    current_branch = get_current_branch()
    print(color(f"Running pre-push checks on branch: {current_branch}", "yellow"))

    changed_files = get_changed_files(current_branch)
    total_errors = 0

    # Run all checks
    total_errors += check_protected_branch(current_branch)
    if total_errors > 0:
        return 1  # Exit early if push was cancelled

    total_errors += check_build_directory()
    total_errors += check_tests()
    total_errors += check_debug_markers(changed_files)
    total_errors += check_commit_messages(current_branch)
    total_errors += check_conflict_markers(changed_files)
    total_errors += check_ignored_files()

    # Final result
    print()
    if total_errors > 0:
        print(color("========================================", "red"))
        print(color(f"Pre-push checks FAILED ({total_errors} errors)", "red"))
        print(color("========================================", "red"))
        print(color("Fix the issues above or use 'git push --no-verify' to skip", "yellow"))
        return 1
    else:
        print(color("========================================", "green"))
        print(color("All pre-push checks passed!", "green"))
        print(color("========================================", "green"))
        return 0


if __name__ == "__main__":
    sys.exit(main())
